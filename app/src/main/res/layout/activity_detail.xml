<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/previewPlayerPlace"
            android:layout_width="match_parent"
            android:layout_height="202dp"
            android:layout_gravity="center_horizontal"
            android:maxWidth="960dp"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_40"
            android:paddingRight="@dimen/dp_50"
            android:paddingBottom="@dimen/dp_10">

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@color/bili_bg_card"
            android:maxWidth="960dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/bili_margin_h"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    >

                    <LinearLayout
                        android:id="@+id/ll_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="鬼灭之刃"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_foreground"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="简介"
                            android:layout_marginLeft="8dp"
                            android:textSize="13sp"
                            android:textColor="@color/bili_blue"
                            android:layout_gravity="bottom"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        >

                            <TextView
                                android:id="@+id/tvSite"
                                android:background="@drawable/bg_small_round_gray"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                tools:text="非凡影视"
                                android:textColor="@color/bili_text_primary"
                                android:textSize="12sp"
                                android:drawableRight="@drawable/ic_arrow_down"
                                android:drawablePadding="4dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/iv_private_browsing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingLeft="10dp"
                            android:src="@drawable/ic_private_browsing"
                            android:visibility="gone"
                            tools:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCast"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/ic_cast_18"
                            android:drawablePadding="4dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingVertical="4dp"
                            android:text="投屏"
                            android:textColor="@color/bili_text_secondary"
                            android:textSize="11sp"
                            app:drawableTint="@color/bili_text_secondary" />

                        <TextView
                            android:id="@+id/tvCollect"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/ic_colloct_18"
                            android:drawablePadding="4dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingVertical="4dp"
                            android:text="收藏"
                            android:textColor="@color/bili_text_secondary"
                            android:textSize="11sp"
                            app:drawableTint="@color/bili_text_secondary" />

                        <TextView
                            android:id="@+id/tvDownload"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:drawableTop="@drawable/ic_download_18"
                            android:drawablePadding="4dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingVertical="4dp"
                            android:text="下载"
                            android:textColor="@color/bili_text_secondary"
                            android:textSize="11sp"
                            app:drawableTint="@color/bili_text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/bili_divider"
                        android:layout_marginTop="14dp"/>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/mEmptyPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/dp_128"
                        android:layout_height="@dimen/dp_128"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:gravity="center"
                        android:text="暂无播放数据"

                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/parse_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="解析"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="14dp"
                        android:layout_marginTop="8dp"
                        android:layout_centerVertical="true"
                        />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_parse"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_select_flag" />
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/bili_margin_h"
                    android:layout_marginTop="14dp">
                    <TextView
                        style="@style/BiliSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="线路"
                        android:layout_centerVertical="true"
                        />
                </RelativeLayout>
                <!--        线路列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridViewFlag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="4dp"
                    tools:listitem="@layout/item_select_flag"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/bili_margin_h"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    >
                    <TextView
                        style="@style/BiliSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选集"
                        />

                    <Space
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="倒序"
                        android:textColor="@color/bili_text_secondary"
                        android:textSize="13sp"
                        android:drawableRight="@drawable/ic_sort_18"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />

                    <View
                        android:id="@+id/line10"
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/bili_divider" />
                    <TextView
                        android:id="@+id/tv_all_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部"
                        android:textColor="@color/bili_text_secondary"
                        android:textSize="13sp"
                        android:drawableRight="@drawable/ic_expand_all_18"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        />
                </LinearLayout>
                <!--        集数列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_10"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:orientation="horizontal"
                    tools:listitem="@layout/item_series"/>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- 高度由 DetailActivity 按 16:9(屏宽*9/16) 动态设置,此处仅为首帧近似值 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="202dp" />

</FrameLayout>
