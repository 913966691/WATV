<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="480dp"
    android:orientation="vertical"
    android:background="@color/bg_popup">

    <!-- Preview area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/bili_bg_chip">

        <ImageView
            android:id="@+id/iv_wp_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/wallpaper_gradient_blue" />
    </FrameLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bili_bg_card"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tv_tab_builtin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="内置壁纸"
            android:textSize="15sp"
            android:textColor="@color/bili_blue" />

        <TextView
            android:id="@+id/tv_tab_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="订阅壁纸"
            android:textSize="15sp"
            android:textColor="@color/bili_text_secondary" />

        <TextView
            android:id="@+id/tv_tab_online"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="在线壁纸"
            android:textSize="15sp"
            android:textColor="@color/bili_text_secondary" />
    </LinearLayout>

    <!-- Wallpaper grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vp_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:background="@color/bili_bg_card"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btn_wp_import"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="导入图片"
            android:textSize="14sp"
            android:textColor="@color/bili_text_secondary"
            android:background="@drawable/bg_large_round_gray" />

        <TextView
            android:id="@+id/btn_wp_close"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="取消"
            android:textSize="15sp"
            android:textColor="@color/bili_text_secondary"
            android:background="@drawable/bg_large_round_gray" />

        <TextView
            android:id="@+id/btn_wp_apply"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="应用壁纸"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:background="@drawable/selector_common_dp_5_blue" />
    </LinearLayout>

</LinearLayout>
