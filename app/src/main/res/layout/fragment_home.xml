<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bili_bg_card"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="110dp"
                android:text="@string/app_title"
                android:textAlignment="gravity"
                android:textColor="@color/text_foreground"
                android:textSize="16dp"
                android:drawablePadding="6dp"
                android:singleLine="true"
                android:drawableRight="@drawable/ic_arrow_down"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/bili_search_h"
            android:background="@drawable/bg_large_round_gray"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:hint="搜索"
            android:textColor="@color/bili_text_primary"
            android:textColorHint="@color/bili_text_tertiary"
            android:textSize="13sp"
            android:singleLine="true"
            android:drawableTint="@color/bili_text_tertiary"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            android:drawableRight="@drawable/ic_search_18"/>

        <ImageView
            android:id="@+id/iv_collect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            app:tint="@color/bili_text_primary"
            android:src="@drawable/ic_collect_48"/>

        <ImageView
            android:id="@+id/iv_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            app:tint="@color/bili_text_primary"
            android:src="@drawable/ic_history_48"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bili_tab_h"
            android:background="@color/bili_bg_card"
            app:tab_indicator_drawable="@drawable/bili_tab_indicator"
            app:tab_indicator_enable_flash="false"
            app:tab_indicator_enable_flash_clip="true"
            app:tab_indicator_height="3dp"
            app:tab_indicator_width="16dp"
            app:tab_select_color="@color/bili_pink"
            app:tab_deselect_color="@color/bili_text_secondary"
            app:tab_text_min_size="14dp"
            app:tab_text_max_size="16dp"
            app:tab_enable_gradient_text_size="false"
            android:layout_marginTop="2dp"
            >

        </com.angcyo.tablayout.DslTabLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            />
    </LinearLayout>
</LinearLayout>