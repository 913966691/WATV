<?xml version="1.0" encoding="utf-8"?>
<com.lihang.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="3dp"
    app:hl_cornerRadius="@dimen/bili_card_radius"
    app:hl_layoutBackground="@color/bili_bg_card"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- B站风格:左上角年度/集数胶囊(黑底半透明) -->
        <TextView
            android:id="@+id/tvYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="6dp"
            android:background="@drawable/bili_badge_bg"
            android:maxWidth="70dp"
            android:ellipsize="end"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            tools:text="1970"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <!-- 收藏页用:检测到该剧更新了新一集时展示的右上角「更新」角标(默认隐藏) -->
        <TextView
            android:id="@+id/tvUpdateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_update"
            android:ellipsize="end"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            android:text="更新"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- B站风格:底部"评分 / 更新至X集"胶囊 + 标题(黑底白字) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_gradient_black_b2t">

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/white"
                tools:text="7.4分"
                android:textSize="11sp"
                android:drawablePadding="4dp"
                />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginTop="2dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:text="爱上大大"
                android:singleLine="true"/>

        </LinearLayout>
    </RelativeLayout>

</com.lihang.ShadowLayout>
