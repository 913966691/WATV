<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:zhy="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bili_bg_page">


    <!-- B站风格搜索顶栏:返回 + 胶囊搜索框 + 粉色"搜索"按钮 -->
    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bili_top_bar_h"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="10dp"
        >

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            app:tint="@color/bili_text_primary"
            android:src="@drawable/ic_arrow_back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/bili_search_h"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="6dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_large_round_gray">

            <com.github.tvbox.osc.ui.widget.ClearEditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="搜索影视"
                android:textColor="@color/bili_text_primary"
                android:textColorHint="@color/bili_text_tertiary"
                android:textSize="14sp"
                android:background="@null"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                />

            <ImageView
                android:id="@+id/iv_filter"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:src="@drawable/ic_filter_list"
                app:tint="@color/bili_text_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="搜索"
            android:textColor="@color/bili_pink"
            android:textSize="15sp"
            android:background="?android:selectableItemBackground" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llSearchSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        >

        <LinearLayout
            android:id="@+id/ll_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginBottom="30dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="历史搜索"
                    android:textSize="15sp"
                    />

                <ImageView
                    android:id="@+id/iv_clear_history"
                    android:layout_width="40dp"
                    android:layout_height="24dp"
                    android:paddingVertical="4dp"
                    android:src="@drawable/ic_clear"
                    app:tint="@color/gray_darker"
                    />
            </LinearLayout>

            <com.zhy.view.flowlayout.TagFlowLayout
                android:id="@+id/fl_history"
                zhy:max_select="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
            </com.zhy.view.flowlayout.TagFlowLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="热门搜索"
            android:textSize="15sp"
            android:textAlignment="center"/>

        <com.zhy.view.flowlayout.TagFlowLayout
            android:id="@+id/fl_hot"
            zhy:max_select="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
        </com.zhy.view.flowlayout.TagFlowLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/llSearchResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tab_draw_highlight="true"
                app:tab_indicator_drawable="@drawable/bg_small_round_gray"
                app:tab_orientation="VERTICAL"
                app:tab_select_color="@color/colorPrimary">


            </com.angcyo.tablayout.DslTabLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_toEndOf="@+id/llWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_5" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_5" />


        </LinearLayout>
    </RelativeLayout>
</LinearLayout>