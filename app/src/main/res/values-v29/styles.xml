<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!--应用的主要色调,actionBar默认使用该颜色,Toolbar导航栏的底色-->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!--CheckBox,RadioButton,SwitchCompat等一般控件的选中效果默认采用该颜色-->
        <item name="colorAccent">@color/colorAccent</item>
        <!--默认window窗口(activity)背景颜色,根据主题修改该属性可 避免某些情况activity跳转/回跳会白屏(出现与主题相反的颜色)-->
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:statusBarColor">@color/bili_bg_card</item>
        <item name="android:navigationBarColor">@color/bili_bg_card</item>
        <!-- 状态栏图标明暗由 BaseActivity 的 ImmersionBar.statusBarDarkFont 按主题动态设置 -->
        <!-- 注意:必须保持 true!
             部分页面(订阅管理/设置/直播频道列表等)的布局是按浅色主题写的,一直依赖系统
             Force Dark 自动反色成深色样式;一旦关掉,这些页面的文字会变回黑色,暗黑背景下无法辨认。
             首页手势条闪黑已由 MainActivity 的 NavBarGuard + bottomNavRoot 自绘背景兜底,
             不依赖本属性,所以这里还原为 true。 -->
        <item name="android:forceDarkAllowed">true</item>
    </style>
</resources>